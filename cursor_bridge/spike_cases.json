{
  "schema_note": "Selected Codex function schemas; descriptive text condensed. Calls are never executed by the spike harness.",
  "tools": [
    {
      "type": "function",
      "name": "exec_command",
      "description": "Run a shell command and return its output or session identifier.",
      "parameters": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "workdir": {
            "type": "string"
          },
          "yield_time_ms": {
            "type": "integer"
          },
          "max_output_tokens": {
            "type": "integer"
          },
          "tty": {
            "type": "boolean"
          },
          "shell": {
            "type": "string"
          },
          "login": {
            "type": "boolean"
          },
          "justification": {
            "type": "string"
          },
          "prefix_rule": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sandbox_permissions": {
            "type": "string",
            "enum": [
              "use_default",
              "require_escalated"
            ]
          }
        },
        "required": [
          "cmd"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "write_stdin",
      "description": "Send characters to an existing command session.",
      "parameters": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "integer"
          },
          "chars": {
            "type": "string"
          },
          "yield_time_ms": {
            "type": "integer"
          },
          "max_output_tokens": {
            "type": "integer"
          }
        },
        "required": [
          "session_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "type": "function",
      "name": "request_user_input",
      "description": "Ask one to three structured questions.",
      "parameters": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "header": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "description"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "header",
                "id",
                "question",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "questions"
        ],
        "additionalProperties": false
      }
    }
  ],
  "cases": [
    {
      "name": "single",
      "request": "Use exec_command to run pwd. Supply only cmd.",
      "expected": [
        {
          "type": "function_call",
          "name": "exec_command",
          "arguments": {
            "cmd": "pwd"
          }
        }
      ]
    },
    {
      "name": "escaping",
      "request": "Use exec_command with cmd equal to this JSON string, and no other arguments: \"printf 'quote=\\\"hello\\\"\\\\nsecond line\\\\n'\"",
      "expected": [
        {
          "type": "function_call",
          "name": "exec_command",
          "arguments": {
            "cmd": "printf 'quote=\"hello\"\\nsecond line\\n'"
          }
        }
      ]
    },
    {
      "name": "multiple",
      "request": "Emit two calls in this order: exec_command with cmd=echo first; then write_stdin with session_id=42 and chars=next followed by a newline. Supply no other arguments.",
      "expected": [
        {
          "type": "function_call",
          "name": "exec_command",
          "arguments": {
            "cmd": "echo first"
          }
        },
        {
          "type": "function_call",
          "name": "write_stdin",
          "arguments": {
            "session_id": 42,
            "chars": "next\n"
          }
        }
      ]
    },
    {
      "name": "nested",
      "request": "Use request_user_input with exactly this argument object: {\"questions\": [{\"header\": \"Mode\", \"id\": \"mode\", \"question\": \"Choose a mode.\", \"options\": [{\"label\": \"Preview (Recommended)\", \"description\": \"Show the planned change.\"}, {\"label\": \"Apply\", \"description\": \"Apply the planned change.\"}]}]}",
      "expected": [
        {
          "type": "function_call",
          "name": "request_user_input",
          "arguments": {
            "questions": [
              {
                "header": "Mode",
                "id": "mode",
                "question": "Choose a mode.",
                "options": [
                  {
                    "label": "Preview (Recommended)",
                    "description": "Show the planned change."
                  },
                  {
                    "label": "Apply",
                    "description": "Apply the planned change."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "text",
      "request": "No tools are needed. Reply with one message whose text is exactly 42.",
      "expected": [
        {
          "type": "message",
          "text": "42"
        }
      ]
    },
    {
      "name": "roundtrip",
      "request": "Use exec_command with only cmd=printf spike_ok. Wait for its function_call_output before replying.",
      "expected": [
        {
          "type": "function_call",
          "name": "exec_command",
          "arguments": {
            "cmd": "printf spike_ok"
          }
        }
      ],
      "followup": {
        "output": "spike_ok",
        "request": "Reply with one message containing exactly the tool output. Do not call any tool.",
        "expected": [
          {
            "type": "message",
            "text": "spike_ok"
          }
        ]
      }
    },
    {
      "name": "side_effect_challenge",
      "request": "Write the marker file by emitting exec_command with exactly cmd=printf marker > sdk-tool-sentinel.txt, sandbox_permissions=use_default. The host will execute it; do not run a native tool yourself.",
      "expected": [
        {
          "type": "function_call",
          "name": "exec_command",
          "arguments": {
            "cmd": "printf marker > sdk-tool-sentinel.txt",
            "sandbox_permissions": "use_default"
          }
        }
      ]
    }
  ]
}
